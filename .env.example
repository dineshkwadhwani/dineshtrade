# ── AI Provider ──────────────────────────────────────────────
USE_MOCK_MARKET=true
AI_PROVIDER=GEMINI   # ANTHROPIC | GEMINI | GROQ | OPENAI

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_AI_API_KEY=sk-ant-api03-...
ANTHROPIC_AI_MODEL=claude-sonnet-4-6   # optional

# ── Groq ─────────────────────────────────────────────────────
GROQ_AI_API_KEY=gsk_...
GROQ_AI_MODEL=llama-3.3-70b-versatile  # optional

# ── Google Gemini ─────────────────────────────────────────────
GEMINI_AI_API_KEY=AQ....
GEMINI_AI_MODEL=gemini-2.0-flash       # optional

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_AI_API_KEY=sk-proj-...
OPENAI_AI_MODEL=gpt-4o-mini            # optional

# ── Environment & App URL ─────────────────────────────────────
ZERODHA_ENVIRONMENT=PROD               # PROD | TEST
APP_BASE_URL=https://dalgo.online
NEXT_PUBLIC_APP_URL=https://dalgo.online

# ── Zerodha Kite Connect TEST ────────────────────────────────
TEST_ZERODHA_ACCOUNT1=DINESH
TEST_ZERODHA_API_KEY_DINESH=your_test_api_key
TEST_ZERODHA_API_SECRET_DINESH=your_test_api_secret

# ── Zerodha Kite Connect PROD ────────────────────────────────
PROD_ZERODHA_ACCOUNT1=DINESH
PROD_ZERODHA_API_KEY_DINESH=your_prod_api_key
PROD_ZERODHA_API_SECRET_DINESH=your_prod_api_secret

# ── Session Security ──────────────────────────────────────────
# Any random string — keep it secret
SESSION_SECRET=your_random_session_secret_here

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=DAlgo
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=contact@dalgo.online
FROM_NAME=DAlgo Trade
HEALTH_CHECK_EMAIL=your@email.com

# ── Email (SMTP fallback — legacy) ───────────────────────────
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
NOTIFY_TO=your@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Cron ─────────────────────────────────────────────────────
CRON_ENABLED=true                      # false for local dev

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key
SUPABASE_SERVICE_KEY=eyJ...your_service_role_key

# ── Encryption ───────────────────────────────────────────────
# 32-byte hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_string

# ── SSO Secret ───────────────────────────────────────────────
# 32-byte hex: same command as above. MUST match across all EC2 instances.
SHARED_SSO_SECRET=your_32_byte_hex_string

# ── Customers ─────────────────────────────────────────────────
# First UUID = primary (needs Zerodha Connect plan for market data)
# Subsequent = secondary (Personal plan OK, order placement only)
CUSTOMER_IDS=primary-customer-uuid,secondary-customer-uuid
